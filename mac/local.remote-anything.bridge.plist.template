<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>local.remote-anything.bridge</string>

  <key>ProgramArguments</key>
  <array>
    <string>__NODE__</string>
    <string>__REPO__/server/sync-server.mjs</string>
    <string>--host</string>
    <string>0.0.0.0</string>
    <string>--port</string>
    <string>8811</string>
  </array>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <true/>

  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/remote-anything.log</string>

  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/remote-anything.log</string>

  <key>WorkingDirectory</key>
  <string>__REPO__</string>
</dict>
</plist>
